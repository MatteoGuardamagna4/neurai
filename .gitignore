# secrets
.env

# environments / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# generated data: everything under data/processed except the two corpus index tables
data/processed/*
!data/processed/units.csv
!data/processed/stimuli.csv
# ...except the small run records (design, seeds, versions, timings): brief §4.3 / D1 logs
!data/processed/phase5/
data/processed/phase5/**
!data/processed/phase5/*/
!data/processed/phase5/*/run.json
!data/processed/choice_rule/
!data/processed/judge/
data/processed/judge/**
!data/processed/judge/judge_summary.json
!data/processed/judge/review_queue.json

# run outputs: logs stay local; tables and figures are the committed deliverable (report all rebuilds them)
outputs/*
!outputs/tables/
!outputs/figures/
!outputs/logs/
outputs/logs/**
!outputs/logs/**/
!outputs/logs/**/run_*.json

# TRIBE outputs (deliverable D3) are far too large for git and live in the citable archive instead
# (scripts/archive_tribe.py). The SHA-256 manifest IS tracked: it identifies the exact bytes behind every
# published number, so a later copy can be proved to be the same data.
data/tribe/*
!data/tribe/MANIFEST.sha256

# the archive bundle itself is a build product; upload it, do not commit it
dist/

MSc*
# report build output (report/build.py)
report/build/
report/orale.md
