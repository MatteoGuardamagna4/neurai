!data/processed/choice_rule/

# run outputs: logs stay local; tables and figures are the committed deliverable (report all rebuilds them)
outputs/*
!outputs/tables/
!outputs/figures/
!outputs/logs/
outputs/logs/**
!outputs/logs/**/
!outputs/logs/**/run_*.json

data/tribe
data/tribe/*

data/tribe_textctl/*